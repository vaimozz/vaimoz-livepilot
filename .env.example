# ─────────────────────────────────────────────────────────────────────────────
# Vaimoz LivePilot — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used by Vite dev server proxy target and CORS
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:8787

# Vite injects this into the React bundle at build time
VITE_API_URL=/api

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: node scripts/generate-secret.js
JWT_SECRET=change-this-to-a-long-random-secret

# ── Database & Storage ────────────────────────────────────────────────────────
DATABASE_PATH=./database.sqlite
UPLOAD_DIR=./public/uploads

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# Path to ffmpeg binary. Use 'ffmpeg' if it's on PATH.
FFMPEG_PATH=ffmpeg

# ── Default Admin (created on first run) ─────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=Admin Vaimoz

# ── Google / YouTube OAuth ────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Application type: Web application
# Scopes: youtube, youtube.force-ssl, youtube.upload
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/youtube/callback

# ── Telegram Notifications (optional) ────────────────────────────────────────
# Get Bot Token from @BotFather, Chat ID from @userinfobot
# These are fallback values — credentials can also be saved via Settings UI
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
