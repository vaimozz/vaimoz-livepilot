# ─────────────────────────────────────────────────────────────────────────────
# Vaimoz LivePilot — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8787

# ── Frontend ──────────────────────────────────────────────────────────────────
# Ganti dengan URL domain/IP VPS kamu
CLIENT_ORIGIN=https://vaimoz.cloud
APP_BASE_URL=https://vaimoz.cloud

# Vite injects this into the React bundle at build time (jangan ubah)
VITE_API_URL=/api

# ── Security ──────────────────────────────────────────────────────────────────
# WAJIB diisi — generate dengan: node scripts/generate-secret.js
JWT_SECRET=change-this-to-a-long-random-secret-minimum-32-chars

# ── Database & Storage ────────────────────────────────────────────────────────
DATABASE_PATH=./database.sqlite
UPLOAD_DIR=./public/uploads

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# Path ke binary ffmpeg. Gunakan 'ffmpeg' jika sudah ada di PATH.
FFMPEG_PATH=ffmpeg

# ── Default Admin (dibuat saat pertama kali run) ─────────────────────────────
# WAJIB ganti password default sebelum deploy!
# Password minimal 8 karakter, harus ada huruf dan angka
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiPasswordIni123
ADMIN_DISPLAY_NAME=Admin Vaimoz

# ── Google / YouTube OAuth ────────────────────────────────────────────────────
# Dapatkan dari: https://console.cloud.google.com → APIs & Services → Credentials
# Application type: Web application
# Scopes: youtube, youtube.force-ssl, youtube.upload, yt-analytics.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://vaimoz.cloud/api/youtube/callback

# ── Telegram Notifications (opsional) ────────────────────────────────────────
# Bot Token dari @BotFather, Chat ID dari @userinfobot
# Bisa juga diset via UI Settings → Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Docker (opsional) ─────────────────────────────────────────────────────────
# Port di host yang di-forward ke container (container selalu pakai PORT=8787)
# Ubah ini jika port 8787 sudah dipakai oleh aplikasi lain
HOST_PORT=8787
