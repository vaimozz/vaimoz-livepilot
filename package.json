{
  "name": "vaimoz-livepilot",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c green,cyan \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite --config client/vite.config.js --host 0.0.0.0",
    "server:dev": "nodemon app.js",
    "server": "node app.js",
    "build": "vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js --host 0.0.0.0",
    "smoke:server": "node --check app.js && node scripts/smoke-server.js",
    "start": "node app.js",
    "migrate": "node scripts/migrate.js",
    "seed:admin": "node scripts/seed-admin.js",
    "reset-password": "node scripts/reset-password.js",
    "generate-secret": "node scripts/generate-secret.js",
    "docker:build": "docker build -t vaimoz-livepilot .",
    "docker:up": "docker compose up --build",
    "reset:data": "node scripts/reset-data.js",
    "clean:data": "node scripts/reset-data.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.16.0",
    "framer-motion": "12.39.0",
    "recharts": "3.8.1",
    "express": "5.2.1",
    "cors": "2.8.6",
    "multer": "2.1.1",
    "better-sqlite3": "12.10.0",
    "bcryptjs": "3.0.3",
    "jsonwebtoken": "9.0.3",
    "dotenv": "17.4.2",
    "googleapis": "171.4.0",
    "node-cron": "4.2.1"
  },
  "devDependencies": {
    "tailwindcss": "4.3.0",
    "postcss": "8.5.14",
    "autoprefixer": "10.5.0",
    "concurrently": "9.2.1",
    "nodemon": "3.1.14",
    "@tailwindcss/postcss": "4.3.0"
  }
}
